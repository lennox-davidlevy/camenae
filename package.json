{
  "name": "camenae",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted personal assistant with persistent conversations and a shared workspace",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "build:ui": "bun build src/ui/chat.tsx --outdir public --target browser --minify",
    "dev": "bun scripts/dev-ui.ts",
    "dev:app": "bun scripts/dev-app.ts",
    "build:app": "bun scripts/build-app.ts",
    "start": "bun src/main.ts",
    "dev:init": "bun scripts/dev-init.ts",
    "auth:init": "bun scripts/auth-init.ts",
    "sdk:stage": "sh scripts/stage-sdk.sh",
    "check:docs": "python3 scripts/check-docs.py",
    "export:source": "python3 scripts/export-source.py",
    "quotes:fetch": "bun tools/quotes/fetch.ts",
    "quotes:candidates": "bun tools/quotes/candidates.ts",
    "quotes:build": "bun tools/quotes/build.ts",
    "quotes:lore": "bun tools/quotes/lexicanum.ts",
    "quotes:build-lore": "bun tools/quotes/lore-build.ts",
    "test:quotes": "bun tools/quotes/test.ts",
    "test:dev-ui": "bun tests/dev-ui.ts",
    "test:threads": "TZ=America/New_York bun tests/thread-list.tsx",
    "test:provisioning": "bun tests/provisioning.ts",
    "test:images": "python3 tests/test-images.py",
    "smoke:foundation": "sh scripts/smoke-foundation.sh",
    "smoke:opencode": "sh scripts/smoke-opencode.sh",
    "smoke:console": "sh scripts/smoke-console.sh"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-markdown": "0.14.18",
    "@camenae/opencode": "./.cache/sdk/camenae-opencode-0.1.0-b24e73923802.tgz",
    "@effect/platform-bun": "4.0.0-rc.118",
    "@effect/sql-pg": "4.0.0-rc.118",
    "@opencode/plugin": "2.0.23",
    "dompurify": "3.4.17",
    "effect": "4.0.0-rc.118",
    "marked": "18.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "solid-js": "1.9.17",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.86.0",
    "typescript": "5.9.3",
    "vite": "8.0.10",
    "vite-plugin-solid": "2.11.14"
  },
  "trustedDependencies": ["@officecli/officecli"]
}
